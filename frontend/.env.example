# =================================================================
# Frontend Environment Configuration (Cloudflare Pages / Local)
# =================================================================

# Backend Base URL (e.g., https://your-backend-service.onrender.com)
# Leave empty for local development to use the local Vite proxy
VITE_API_BASE_URL=

# WebSocket Alert URL (optional - if omitted, auto-derives from VITE_API_BASE_URL)
# e.g., wss://your-backend-service.onrender.com/ws/alerts
VITE_WS_URL=
